# Redis 설정
REDIS_URL=redis://localhost:6379

# DynamoDB 설정
DYNAMODB_HISTORY_TABLE=langchain_chat_history
AWS_REGION=ap-northeast-2

# 히스토리 관리자 선택 (true: LangChain, false: Custom)
USE_LANGCHAIN_HISTORY=true

# Strands Agent 설정
STRANDS_MODEL_PROVIDER=bedrock
STRANDS_MODEL_ID=anthropic.claude-3-7-sonnet-20241022-v1:0
STRANDS_REGION=us-west-2

# 개발 모드
DEVELOPMENT_MODE=true

# AWS 자격 증명 (선택사항 - AWS CLI 또는 IAM Role 사용 권장)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# FastAPI 설정
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis 설정
REDIS_URL=redis://localhost:6379

# AWS 설정 (Strands Agent용)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Strands Agent 설정 (Version 1.0.1)
STRANDS_MODEL_PROVIDER=bedrock
STRANDS_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
STRANDS_REGION=ap-northeast-2

# Alternative Model Providers (선택적)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# Strands Agent SDK 1.0.1 설정
DEVELOPMENT_MODE=false
USE_STRANDS_SDK=true

# 히스토리 관리자 선택 (true: LangChain, false: Custom)
USE_LANGCHAIN_HISTORY=true

# LangChain DynamoDB 테이블 이름
DYNAMODB_HISTORY_TABLE=langchain_chat_history

# Strands Agent 1.0.1 새로운 설정들
STRANDS_MAX_ITERATIONS=10
STRANDS_ENABLE_TRACING=true
STRANDS_MEMORY_ENABLED=true

# 1.0.1 추가 설정
STRANDS_TIMEOUT=30
STRANDS_RETRY_COUNT=3
STRANDS_LOG_LEVEL=INFO
